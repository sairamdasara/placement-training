import java.util.*;

public class main {
    static int count = 0; // global counter

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n;
        System.out.println("Enter number of stairs:");
        n = sc.nextInt();

        if (n == 0) {
            System.out.println("No ways");
            return;
        }

       // System.out.println("Ways to climb " + n + " stairs:");
        printWays("", n);
        System.out.println("Total number of ways: " + count);
    }

    static void printWays(String path, int n) {
        if (n == 0) {
            System.out.println(path.trim());
            count++; // increment count for each complete path
            return;
        }
        if (n >= 1) {
            printWays(path + "1 ", n - 1); // take 1 step
        }
        if (n >= 2) {
            printWays(path + "2 ", n - 2); // take 2 steps
        }
    }
}
